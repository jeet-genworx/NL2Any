# KOBOLDCPP_BASE_URL is deliberately left unset/commented.
#
# Docker Compose reads this .env file for ${VAR} substitution, so setting it here
# also injects it into the containers -- where 127.0.0.1 means the container
# itself, not your host, and KoboldCpp becomes unreachable.
#
# Leave it commented and each context picks the right default automatically:
#   - running on the host: config.py defaults to http://127.0.0.1:5001/v1
#   - running in Docker:   compose defaults to http://host.docker.internal:5001/v1
#
# Only set it if KoboldCpp is somewhere else entirely (e.g. another machine),
# and note that value will then be used by BOTH host and container runs.
# KOBOLDCPP_BASE_URL=http://127.0.0.1:5001/v1
KOBOLDCPP_MODEL=qwen3-4b-instruct-2507
# Embedding model loaded alongside the chat model via KoboldCpp's --embeddingsmodel flag
KOBOLDCPP_EMBEDDING_MODEL=all-MiniLM-L6-v2-Q8_0

# PostgreSQL (Local or Docker)
# If using the provided Docker container: postgresql://nl2user:nl2password@postgres:5432/nl2anyquery_db
POSTGRES_DSN=postgresql://username:password@localhost:5432/dbname
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=nl2anyquery_demo

# Number of documents sampled per collection when inferring MongoDB schema (ingestion)
MONGO_SAMPLE_LIMIT=10

BM25_TOP_K=10
MODEL_TEMPERATURE=0.1
MODEL_MAX_TOKENS=1500
QUERY_TIMEOUT_SECONDS=10
MAX_RESULT_ROWS=1000
SIMILARITY_THRESHOLD=0.25

